# Generate fresh testnet wallets with: npm run wallets:new
# Never put mainnet keys here. This file is a template; the real values go in .env (gitignored).

# Hono API port (internal). The Next.js front door (client/) proxies to it.
PORT=4021
# Next.js front-door port (public). `npm start` points the tunnel here.
WEB_PORT=3000
# prod (default): `npm start` builds and serves the production web app. dev: `next dev` with hot reload.
WEB_MODE=prod
# Public HTTPS base URL. Leave empty to let `npm start` open a tunnel and fill it in.
PUBLIC_BASE_URL=
# auto (cloudflared, then ngrok) | cloudflared | ngrok | none
TUNNEL=auto
# Optional explicit binary paths (default: tools/<name>.exe, then PATH)
NGROK_PATH=
CLOUDFLARED_PATH=
# ngrok needs a free authtoken from https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=
# Optional free static domain from https://dashboard.ngrok.com/domains (keeps the public URL stable across restarts)
NGROK_DOMAIN=

FACILITATOR_URL=https://x402.org/facilitator
BASE_SEPOLIA_RPC=https://sepolia.base.org

# Buyer agent (Scout) - the only key used at runtime
BUYER_PRIVATE_KEY=

# Seller payTo addresses (sellers only need an address to receive USDC)
PAYTO_SHELF_SCRAPER=
PAYTO_CHEAP_SCRAPER=
PAYTO_FX_RATES=
PAYTO_HINDI_SUMMARY=
PAYTO_CITY_INFO=
PAYTO_SENTIMENT=
PAYTO_JUNK_FX=
PAYTO_MIRROR_SCRAPER=
# "promo-scraper" demo seller: valid output with a hidden prompt injection for the buyer's AI
PAYTO_PROMO_SCRAPER=
# Address the "mirror-scraper" demo seller wrongly puts in its 402 (payTo swap attack)
PAYTO_ATTACKER=

# "travel-brief" is the agent-chain seller: it hires other sellers, so unlike the sellers above the server loads its key to pay them.
# Fund this wallet with a little testnet USDC (float); each sale refills it. TRAVEL_BRIEF_KEY is created by `npm run wallets:new`.
TRAVEL_BRIEF_KEY=

# SellerStakeV2: a slash needs 2 of 3 verifier signatures. The relayer deploys the contract and pays gas for stakes, claims
# and refunds (no other powers), so send it ~0.01 Base Sepolia ETH. Filled by `npm run wallets:new` and `npm run stake:deploy`.
RELAYER_PRIVATE_KEY=
STAKE_CONTRACT=
# This server's verifier, and the one `npm run verifier` uses. In production each verifier key lives on its own host.
SERVER_VERIFIER_KEY=
VERIFIER_KEY=
# Signs the X-Gandiva-Receipt the built-in sellers attach to paid responses (evidence for stake claims). Holds no money.
# Filled by `npm run wallets:new`.
RECEIPT_SIGNER_KEY=
# Priority scheduler: concurrent paid calls per paying wallet and per seller.
PAY_SLOTS_PER_WALLET=5
PAY_SLOTS_PER_SELLER=4
PAYTO_TRAVEL_BRIEF=

# LLM: local Ollama (OLLAMA_HOST=http://127.0.0.1:11434, OLLAMA_MODEL=qwen2.5:7b)
# or Ollama cloud (OLLAMA_HOST=https://ollama.com, a cloud model such as gpt-oss:20b, and an API key from ollama.com/settings/keys)
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=gpt-oss:20b
OLLAMA_API_KEY=

# Optional: require this token (header x-buyer-token) to make the buyer spend
BUYER_TOKEN=

# Wallet-wide spend cap across all runs: at most this many USDC per rolling window. 0 turns it off.
SPEND_CAP_USDC=0.5
SPEND_CAP_WINDOW_MIN=60

# Reputation: a call's weight halves every this many hours (0 = no time decay); a seller with fewer calls than this is "new".
REPUTATION_HALF_LIFE_HOURS=6
REPUTATION_NEW_ATTEMPTS=3

# May registry listings point at private/loopback addresses? auto = only while PUBLIC_BASE_URL is localhost; true / false force it.
ALLOW_PRIVATE_ENDPOINTS=auto

# Needed to DELETE registry listings (header x-admin-token). Leave empty to disable deleting.
ADMIN_TOKEN=

# Where the UI runs (comma list). Wallet sign-ins naming any other site are refused.
# Default: http://localhost:3000,http://localhost:3001,https://gandiva-navy.vercel.app
# SITE_ORIGINS=

# Shared with the UI (set the same value as PROXY_SECRET on Vercel): lets the API trust the visitor IP the UI's proxy
# forwards, so rate limits apply per visitor and not to Vercel as a whole. Any long random string; unset = never trusted.
# PROXY_SECRET=

# Register the adversarial demo sellers (greedy price, payTo swap, junk output)
SEED_ADVERSARIAL=true


# Scout planning mode: auto (LLM agent, books pipeline as fallback) | agent (never fall back) | legacy (books pipeline only)
SCOUT_MODE=auto

# Run every built-in seller as its own process (own port and own SQLite file in data/sellers/) behind the same public
# URLs. off = all sellers inside the main server (default). Ports are SELLER_BASE_PORT, +1, +2, ... on 127.0.0.1 only.
SELLER_PROCESSES=off
SELLER_BASE_PORT=4100

# Hosted only (set on Render, not needed locally): Litestream copies data/gandiva.db to an S3-compatible bucket and restores it
# on start, so a host without a disk keeps its data. Leave LITESTREAM_BUCKET empty to run without replication.
# LITESTREAM_BUCKET=
# LITESTREAM_ENDPOINT=https://s3.us-east-005.backblazeb2.com
# LITESTREAM_REGION=us-east-005
# LITESTREAM_ACCESS_KEY_ID=
# LITESTREAM_SECRET_ACCESS_KEY=

# Encrypts secrets stored in the database (sellers' Ollama API keys, per-user agent wallet keys): 64 hex characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRETS_KEY=
